{
  "name": "sendix",
  "productName": "Sendix",
  "version": "0.2.0",
  "description": "Cliente de API de escritorio, local primero y compatible con colecciones Postman v2.1.",
  "author": "Luis E. Bautista",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run test && npm run test:e2e",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@grpc/grpc-js": "1.14.6",
    "@lezer/highlight": "1.2.5",
    "@postman/tough-cookie": "4.1.3-postman.1",
    "electron-updater": "6.8.10",
    "jsonpath-plus": "11.2.0",
    "openapi-to-postmanv2": "6.4.0",
    "postman-collection": "5.3.1",
    "postman-runtime": "7.56.1",
    "protobufjs": "7.6.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4",
    "ws": "8.22.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@grpc/proto-loader": "0.8.1",
    "@grpc/reflection": "1.0.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "socket.io": "4.8.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron@44.9.3": true,
    "electron-winstaller": false,
    "protobufjs": false
  }
}
